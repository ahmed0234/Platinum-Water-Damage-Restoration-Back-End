# ==============================================================================
# Platinum Backend - Environment Variables Template
# Copy this file to .env for local development:
#   cp .env.example .env
# For Vercel production deployment, configure these in Project Settings -> Environment Variables.
# ==============================================================================

# 1. Resend API Key (Obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_1234567890abcdef_placeholder

# 2. Sender Address in Resend
# Must use an address from your verified domain (e.g. ikhtiyaar.com)
RESEND_FROM_EMAIL=Platinum Leads <notifications@ikhtiyaar.com>

# 3. Recipient Email Addresses
# Both addresses will receive an email upon every validated form submission
RECIPIENT_EMAIL_1=office@cleanmastercarpetcleaning.com
RECIPIENT_EMAIL_2=muhammad.bilal@ikhtiyaar.com

# 4. Allowed Frontend Domains / Origins (for Server-Side Origin & CORS Validation)
# Comma-separated list of origins permitted to submit form requests (no trailing slashes).
# Supports exact origins or wildcard subdomains (e.g., https://*.vercel.app).
ALLOWED_ORIGINS=https://platinumsg.com,http://platinumsg.com,https://www.platinumsg.com,http://www.platinumsg.com,https://*.vercel.app,http://localhost:5173
